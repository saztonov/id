#!/bin/sh
#
# Гейт исполняется ПЕРЕД отправкой в origin.
#
# Почему здесь, а не в CI. У проекта одна ветка `main` и линейная история, PR
# нет. CI после `push` в такой работе — не гейт, а уведомление: к моменту его
# падения сломанное уже в `origin/main`. Так и вышло — сорок красных прогонов
# подряд, которых никто не открыл. Хук останавливает выкладку ДО отправки, то
# есть делает то, чего CI в этой работе сделать не мог.
#
# Подключается один раз:  pnpm hooks:install
# (он ставит `core.hooksPath=tools/githooks`, поэтому хук версионируется в
# репозитории, а не живёт в `.git/hooks` на одной машине).
#
# `--no-verify` обходит этот хук. Это не рабочий приём: он снимает единственный
# рубеж между рабочим столом и `origin/main`.

# Удаление ветки (`git push --delete`) кода не отправляет — гонять гейт незачем.
z40="0000000000000000000000000000000000000000"
all_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$z40" ] || all_deletes=0
done
[ "$all_deletes" = "1" ] && exit 0

echo "pre-push: гейт (pnpm gate). Обойти можно только --no-verify, и это не приём."
if ! pnpm gate; then
  echo ""
  echo "PUSH ОТМЕНЁН: гейт не пройден. Причина и команда перезапуска — выше."
  exit 1
fi
