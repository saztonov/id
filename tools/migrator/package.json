{
  "name": "@id/migrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsc -p tsconfig.build.json && node dist/cli.js"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@id/db-harness": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
