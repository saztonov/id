# Портал ИД (id) — production-конфиг. Копия: /etc/id/id.env (640 root:docker).
# В git НЕ коммитится. Ключи = apps/api/src/config/env.ts.
# ВАЖНО: не печатать этот файл в чат/лог целиком.

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://id.su10.ru

# Managed PostgreSQL. БД — ID. Runtime-роль — fin_id (как у fin).
# Пароль URL-encode; sslmode в URL допустим — код вырезает его и использует PG_CA_CERT_PATH.
DATABASE_URL=postgres://fin_id:ПАРОЛЬ@<host>:6432/ID?sslmode=verify-full
PG_POOL_MAX=10
PG_CA_CERT_PATH=/etc/id/root.crt

# Auth. В production допустимы ДВА режима (ADR-0009):
#   oidc  — корпоративный Keycloak (основной);
#   local — вход логином и паролем, когда realm недоступен.
# AUTH_MODE=dev-stub в production запрещён кодом.
AUTH_MODE=oidc

# --- только при AUTH_MODE=oidc ---
OIDC_ISSUER=https://auth.su10.ru/realms/<realm>
OIDC_CLIENT_ID=id-portal
OIDC_CLIENT_SECRET=

# --- только при AUTH_MODE=local ---
# openssl rand -base64 48 → ключ HMAC троттлинга входа (32+ байта).
# Отдельный от AUDIT_HMAC_KEY: ротация ключа журнала не должна снимать блокировки.
# Обязателен при local; при oidc наличие этой переменной роняет старт.
# AUTH_LOCAL_LOGIN_HMAC_KEY=
# AUTH_LOCAL_REGISTRATION_ENABLED=true
# Минимальная длина пароля — единственное требование политики; проверок сложности нет.
# AUTH_LOCAL_PASSWORD_MIN_LENGTH=8
#
# Первого администратора заводит seed-миграция: admin@test.com / qwedcxz1@.
# Логином до подключения Keycloak служит введённый адрес почты.
# ЭТОТ ПАРОЛЬ ЛЕЖИТ В РЕПОЗИТОРИИ и одинаков во всех развёртываниях. До смены
# учётная запись не может ничего, кроме самой смены, но войти ею может любой,
# кто видел код. В production смените пароль СРАЗУ после первого входа.
# Если он забыт:  pnpm local-admin reset --email admin@test.com

# openssl rand -base64 32  →  SESSION_ENC_KEY (ровно 32 байта после base64-decode)
SESSION_ENC_KEY=
SESSION_ENC_KEY_VERSION=1
# openssl rand -base64 48
CSRF_SECRET=
AUDIT_HMAC_KEY=

SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# S3 (production запрещает STORAGE_DRIVER=local)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.cloud.ru
S3_BUCKET=id1
S3_REGION=ru-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# LLM через корпоративный шлюз proxy_llm (не openrouter.ai напрямую — §10).
# Токен — в /etc/id/id.env с хоста; тот же шлюз, что у estimat (AI_OPENROUTER_*).
LLM_PROVIDER=proxy_llm
PROXY_LLM_BASE_URL=https://proxyllm.fvds.ru/api/v1
PROXY_LLM_TOKEN=
LLM_MODEL=qwen/qwen3.8-27b
# В production пустой allowlist = запрет всех моделей.
# Сюда же входит модель распознавания из recognition.vlm_model: без неё в списке
# прогон отвечает 409 ещё до создания. Модель распознавания обязана принимать
# картинки и исполнять strict json_schema — см. deploy/README.md.
LLM_MODEL_ALLOWLIST=qwen/qwen3.8-27b
# Потолок ожидания ответа шлюза на один LLM/VLM-вызов. Должен быть чуть выше
# REQUEST_DEADLINE_MS прокси (420000), иначе worker оборвёт раньше, чем прокси
# вернёт 504. Дефолт в коде — 240000, для 27B-моделей этого мало.
LLM_TIMEOUT_MS=450000
# RD WEB не обязателен на первом подъёме — не задавать RDWEB_* без интеграции

# --- Воркер: границы нагрузки на общий хост (S41) ---
# Параллелизм очередей. Диапазоны и умолчания — apps/api/src/jobs/types.ts
# (io 1–8, cpu 1–2, llm 1–4); значение вне диапазона молча зажимается, ноль и
# мусор роняют старт. Сумма трёх чисел обязана быть МЕНЬШЕ PG_POOL_MAX: иначе
# задачи ждут соединение, и это ожидание выглядит в логе как медленная БД.
#   io  — ожидание сети и БД (S3, RD WEB, сводные задачи);
#   cpu — счёт и память: рендер, ONNX-детекция, сборка PDF. На 2 vCPU держать 1;
#   llm — ВСЕ обращения к модели, включая зонд разворота. Это же и потолок
#         одновременных HTTP к proxy_llm.
WORKER_CONCURRENCY_IO=3
WORKER_CONCURRENCY_CPU=1
WORKER_CONCURRENCY_LLM=2

# Служебный /metrics воркера. Наружу не проксируется (см. deploy/nginx),
# его читает healthcheck контейнера и ручной curl при разборе нагрузки.
WORKER_METRICS_PORT=9101

# Сколько ждать текущие задачи при остановке. Обязано быть МЕНЬШЕ
# stop_grace_period контейнера (45s): разница — запас на закрытие журнала и
# пула. Незавершённая задача не теряется: аренда истечёт, её подберёт reaper.
WORKER_SHUTDOWN_TIMEOUT_MS=20000

# Мягкий потолок памяти воркера, МиБ: выше него новые задачи не берутся, пока
# текущие не освободят память. Берётся с запасом ниже mem_limit (1536m): задача
# добирает память уже ПОСЛЕ захвата, и смысл сторожа в том, чтобы до убийства по
# cgroup дело не дошло. Не задан — сторож выключен.
WORKER_RSS_SOFT_LIMIT_MB=1200

# Потоки ONNX для локальной детекции (ADR-0008). intra — счётные потоки одной
# операции, inter — параллельные операции. На 2 vCPU: 2 и 1.
ORT_INTRA_OP_THREADS=2
ORT_INTER_OP_THREADS=1


# Сеть edge: подсеть docker bridge (infra-nginx). Уточнить: docker network inspect edge
TRUST_PROXY=172.18.0.0/16
TRUST_REQUEST_ID=true

# Только для рендера nginx-шаблона (envsubst), в приложение не читается
ID_DOMAIN=id.su10.ru

# Версия развёрнутого кода: попадает в каждую запись журнала ошибок и в
# почасовой ряд (§11, ADR-0010). Без неё вопрос «сломалось ли после деплоя»
# решается сверкой времени всплеска с временем выкатки по памяти. Значение
# проставляет деплой — например, тег образа или короткий хэш коммита.
APP_RELEASE=
