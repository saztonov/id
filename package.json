{
  "name": "id-portal",
  "version": "0.0.0",
  "private": true,
  "description": "Портал исполнительной документации",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "gate": "node tools/scripts/gate.mjs",
    "gate:clean": "node tools/scripts/gate-clean.mjs",
    "hooks:install": "git config core.hooksPath tools/githooks",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "node tools/scripts/format-check.mjs",
    "db:probe": "pnpm --filter @id/db-harness probe",
    "harness:run": "pnpm --filter @id/check-harness... build && pnpm --filter @id/check-harness harness",
    "fixtures:generate": "pnpm --filter @id/fixtures generate",
    "corpus:generate": "pnpm --filter @id/fixtures generate:corpus",
    "pii:scan": "node tools/scripts/pii-scan.mjs",
    "db:schema:generate": "pnpm --filter @id/db schema:generate",
    "seed:generate": "node tools/scripts/generate-seed-migration.mjs",
    "rules:seed:generate": "node tools/scripts/generate-rules-seed-migration.mjs",
    "prompts:seed:generate": "node tools/scripts/generate-recognition-prompts-seed-migration.mjs",
    "analysis-prompts:seed:generate": "node tools/scripts/generate-analysis-prompts-seed-migration.mjs",
    "test:e2e": "pnpm --filter @id/web test:e2e",
    "test:e2e:local": "pnpm --filter @id/web test:e2e:local",
    "local-admin": "pnpm --filter @id/api local-admin",
    "link-sso": "pnpm --filter @id/api link-sso"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3",
      "zod": "4.4.3",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  }
}
