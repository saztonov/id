# Конфигурация портала ИД.
#
# Скопируйте в `.env` и заполните. Значения ниже — заглушки: `loadEnv()`
# отвергает их при старте (`nonPlaceholder`), поэтому забытое поле роняет запуск,
# а не доезжает до боевого стенда.
#
# Полный перечень и правила — `apps/api/src/config/env.ts`; здесь только то, что
# нужно задать руками, с пояснением, чем чревато неверное значение.

# =====================================================================
# Базовое
# =====================================================================

NODE_ENV=development
PORT=3000

# Публичный адрес портала. В production обязан быть https: cookie помечены Secure.
# Он же — источник redirect_uri для OIDC и разрешённый источник формы входа.
PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://id_app:changeme@localhost:5432/id
# TLS без проверки CA небезопасен, поэтому в production путь к корневому
# сертификату обязателен.
PG_CA_CERT_PATH=

# Список доверенных прокси. В production обязателен: без него адрес клиента за
# nginx неизвестен, лимит запросов становится общим для всех пользователей, а
# `auth_sessions.ip` у каждого равен адресу прокси.
TRUST_PROXY=

# =====================================================================
# Режим аутентификации
# =====================================================================

# oidc      — корпоративный Keycloak (боевой федеративный режим);
# local     — вход логином и паролем без Keycloak (ADR-0009), разрешён в production;
# dev-stub  — заглушка разработки, ЗАПРЕЩЕНА при NODE_ENV=production.
AUTH_MODE=local

# --- только при AUTH_MODE=oidc ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- только при AUTH_MODE=local ---

# Ключ HMAC для ключей троттлинга входа, 32+ байта.
#
# Обязателен во ВСЕХ окружениях, а не только в production: по нему ключуются
# строки `auth_throttle`. Без него защиты от перебора нет вовсе.
#
# Отдельный от AUDIT_HMAC_KEY намеренно: ротация ключа журнала не должна массово
# снимать блокировки входа.
AUTH_LOCAL_LOGIN_HMAC_KEY=

# Приём заявок на регистрацию. Заявка НЕ создаёт пользователя: её рассматривает
# администратор во вкладке «Заявки на доступ».
AUTH_LOCAL_REGISTRATION_ENABLED=true

# Границы длины пароля. Умолчание 12 — «рекомендуемая длина» корпоративного
# стандарта (минимум 8). Для развёртывания БЕЗ MFA разумно поднять до 15.
AUTH_LOCAL_PASSWORD_MIN_LENGTH=12
AUTH_LOCAL_PASSWORD_MAX_LENGTH=128

# Стоимость scrypt: N = 2^значение, при r=8 и p=2 это профиль OWASP.
# Понижать в production нельзя; в тестах понижается до 15 ради скорости.
AUTH_LOCAL_SCRYPT_COST_LOG2=16
AUTH_LOCAL_SCRYPT_PARALLELISM=2

# Сколько проверок пароля выполняется одновременно. Каждая занимает ~64 МБ и
# поток пула libuv (по умолчанию их четыре): без предела всплеск входов вытесняет
# из пула всё остальное. Переполнение очереди отвечает 429.
AUTH_LOCAL_HASH_CONCURRENCY=4

# Лимиты (B.7). Блокировка по логину наступает после десяти неудач за час.
AUTH_LOCAL_LOGIN_MAX_PER_IP=5
AUTH_LOCAL_LOGIN_WINDOW_MINUTES=15
AUTH_LOCAL_LOCKOUT_MINUTES=30
AUTH_LOCAL_BACKOFF_MAX_SECONDS=30
AUTH_LOCAL_REGISTER_MAX_PER_IP_HOUR=3
AUTH_LOCAL_PASSWORD_MAX_PER_HOUR=5

# Дополнительные источники, которым разрешено отправлять форму входа.
#
# Нужен ТОЛЬКО для разработки. `vite dev` проксирует с `changeOrigin: false`,
# поэтому браузер шлёт `Origin: http://localhost:5173`, а PUBLIC_URL указывает на
# :3000 — без этой строки форма входа молча отвечает 403.
#
# В production запрещён: там SPA и API живут за одним адресом, и лишний источник
# здесь — это разрешение отправлять форму входа с чужой страницы.
# AUTH_LOCAL_ALLOWED_ORIGINS=http://localhost:5173

# =====================================================================
# Сессии, CSRF, журнал
# =====================================================================

# Ключ шифрования refresh-токена в сессии: ровно 32 байта в base64.
# Обязателен в production; вне его генерируется случайный на время жизни процесса.
SESSION_ENC_KEY=
SESSION_ENC_KEY_VERSION=1
CSRF_SECRET=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Ключ HMAC адреса в audit_log. Обязателен в production и при AUTH_MODE=local.
AUDIT_HMAC_KEY=

# =====================================================================
# Хранилище
# =====================================================================

# s3 — боевое; local — только разработка (в production запрещено: стандарт не
# допускает постоянного хранения пользовательских данных на VPS).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central-1
LOCAL_STORAGE_DIR=

# =====================================================================
# Порядок развёртывания при AUTH_MODE=local
# =====================================================================
#
#   1. pnpm build
#   2. миграции
#   3. запуск API
#
# Отдельного шага для первого администратора нет: его заводит seed-миграция.
#
#   логин admin@test.com, пароль qwedcxz1@
#
# Логином до подключения Keycloak служит введённый адрес почты — у встроенной
# записи и у всех, кого заводят регистрацией, админкой или CLI.
#
# ВНИМАНИЕ. Этот пароль лежит в репозитории, то есть известен всем, у кого есть
# доступ к коду, и одинаков во всех развёртываниях. До смены пароля учётная
# запись не может ничего, кроме входа и самой смены, но войти ею может любой,
# кто видел файл миграции. Смените пароль сразу после первого входа.
#
# Новый пароль обязан удовлетворять политике (от 12 символов), поэтому задать
# qwedcxz1@ заново через портал не получится — это ожидаемо.
#
# Если пароль забыт после смены:  pnpm local-admin reset --email admin@test.com
#
# Старт API ПРОВЕРЯЕТ, что активный администратор с локальным паролем есть, и в
# production отказывается подниматься, если его нет: это ловит случай, когда
# встроенную учётную запись удалили или отключили.
#
# Переход на Keycloak позже НЕ сводится к смене AUTH_MODE: сначала обязательно
# связать учётные записи, иначе Keycloak заведёт людям вторые, беспра́вные строки.
#
#   pnpm link-sso --map ./sso-map.json --dry-run
#   pnpm link-sso --map ./sso-map.json --apply

# --- Наблюдаемость (§11) ---
# Версия развёрнутого кода: попадает в каждую запись журнала ошибок и в
# почасовой ряд, и по ней журнал отвечает на «сломалось после деплоя»
# (ADR-0010). Пусто — в ряде честно стоит `unknown`.
APP_RELEASE=
