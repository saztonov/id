# Конфигурация портала ИД.
#
# Скопируйте в `.env` и заполните. Значения ниже — заглушки: `loadEnv()`
# отвергает их при старте (`nonPlaceholder`), поэтому забытое поле роняет запуск,
# а не доезжает до боевого стенда.
#
# Полный перечень и правила — `apps/api/src/config/env.ts`; здесь только то, что
# нужно задать руками, с пояснением, чем чревато неверное значение.

# =====================================================================
# Базовое
# =====================================================================

NODE_ENV=development
PORT=3000

# Публичный адрес портала. В production обязан быть https: cookie помечены Secure.
# Он же — источник redirect_uri для OIDC и разрешённый источник формы входа.
PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://id_app:changeme@localhost:5432/id
# TLS без проверки CA небезопасен, поэтому в production путь к корневому
# сертификату обязателен.
PG_CA_CERT_PATH=

# Список доверенных прокси. В production обязателен: без него адрес клиента за
# nginx неизвестен, лимит запросов становится общим для всех пользователей, а
# `auth_sessions.ip` у каждого равен адресу прокси.
TRUST_PROXY=

# =====================================================================
# Режим аутентификации
# =====================================================================

# oidc      — корпоративный Keycloak (боевой федеративный режим);
# local     — вход логином и паролем без Keycloak (ADR-0009), разрешён в production;
# dev-stub  — заглушка разработки, ЗАПРЕЩЕНА при NODE_ENV=production.
AUTH_MODE=local

# --- только при AUTH_MODE=oidc ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- только при AUTH_MODE=local ---

# Ключ HMAC для ключей троттлинга входа, 32+ байта.
#
# Обязателен во ВСЕХ окружениях, а не только в production: по нему ключуются
# строки `auth_throttle`. Без него защиты от перебора нет вовсе.
#
# Отдельный от AUDIT_HMAC_KEY намеренно: ротация ключа журнала не должна массово
# снимать блокировки входа.
AUTH_LOCAL_LOGIN_HMAC_KEY=

# Приём заявок на регистрацию. Заявка НЕ создаёт пользователя: её рассматривает
# администратор во вкладке «Заявки на доступ».
AUTH_LOCAL_REGISTRATION_ENABLED=true

# Границы длины пароля. Минимальная длина — единственное требование к паролю:
# проверок сложности (классы символов, словари, последовательности) нет.
AUTH_LOCAL_PASSWORD_MIN_LENGTH=8
AUTH_LOCAL_PASSWORD_MAX_LENGTH=128

# Стоимость scrypt: N = 2^значение, при r=8 и p=2 это профиль OWASP.
# Понижать в production нельзя; в тестах понижается до 15 ради скорости.
AUTH_LOCAL_SCRYPT_COST_LOG2=16
AUTH_LOCAL_SCRYPT_PARALLELISM=2

# Сколько проверок пароля выполняется одновременно. Каждая занимает ~64 МБ и
# поток пула libuv (по умолчанию их четыре): без предела всплеск входов вытесняет
# из пула всё остальное. Переполнение очереди отвечает 429.
AUTH_LOCAL_HASH_CONCURRENCY=4

# Лимиты (B.7). Блокировка по логину наступает после десяти неудач за час.
AUTH_LOCAL_LOGIN_MAX_PER_IP=5
AUTH_LOCAL_LOGIN_WINDOW_MINUTES=15
AUTH_LOCAL_LOCKOUT_MINUTES=30
AUTH_LOCAL_BACKOFF_MAX_SECONDS=30
AUTH_LOCAL_REGISTER_MAX_PER_IP_HOUR=3
AUTH_LOCAL_PASSWORD_MAX_PER_HOUR=5

# Дополнительные источники, которым разрешено отправлять форму входа.
#
# Нужен ТОЛЬКО для разработки. `vite dev` проксирует с `changeOrigin: false`,
# поэтому браузер шлёт `Origin: http://localhost:5173`, а PUBLIC_URL указывает на
# :3000 — без этой строки форма входа молча отвечает 403.
#
# В production запрещён: там SPA и API живут за одним адресом, и лишний источник
# здесь — это разрешение отправлять форму входа с чужой страницы.
# AUTH_LOCAL_ALLOWED_ORIGINS=http://localhost:5173

# =====================================================================
# Сессии, CSRF, журнал
# =====================================================================

# Ключ шифрования refresh-токена в сессии: ровно 32 байта в base64.
# Обязателен в production; вне его генерируется случайный на время жизни процесса.
SESSION_ENC_KEY=
SESSION_ENC_KEY_VERSION=1
CSRF_SECRET=
# Окно простоя (скользящее) и абсолютный потолок сессии. Окно двигает любой
# запрос к API, включая пульс SPA раз в 15 минут; абсолютный срок не двигает
# ничто — он и не даёт сессии стать вечной.
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=168
# Сколько строка auth_sessions живёт после конца сессии (адрес и User-Agent).
SESSION_RETENTION_DAYS=30

# Ключ HMAC адреса в audit_log. Обязателен в production и при AUTH_MODE=local.
AUDIT_HMAC_KEY=

# =====================================================================
# Хранилище
# =====================================================================

# s3 — боевое; local — только разработка (в production запрещено: стандарт не
# допускает постоянного хранения пользовательских данных на VPS).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central-1
LOCAL_STORAGE_DIR=

# =====================================================================
# Порядок развёртывания при AUTH_MODE=local
# =====================================================================
#
#   1. pnpm build
#   2. миграции
#   3. запуск API
#
# Отдельного шага для первого администратора нет: его заводит seed-миграция.
#
#   логин admin@test.com, пароль qwedcxz1@
#
# Логином до подключения Keycloak служит введённый адрес почты — у встроенной
# записи и у всех, кого заводят регистрацией, админкой или CLI.
#
# ВНИМАНИЕ. Этот пароль лежит в репозитории, то есть известен всем, у кого есть
# доступ к коду, и одинаков во всех развёртываниях. До смены пароля учётная
# запись не может ничего, кроме входа и самой смены, но войти ею может любой,
# кто видел файл миграции. Смените пароль сразу после первого входа.
#
# Задать qwedcxz1@ заново через портал не получится: новый пароль не должен
# совпадать с текущим. Пароль первого входа и не должен переживать первый вход.
#
# Если пароль забыт после смены:  pnpm local-admin reset --email admin@test.com
#
# Старт API ПРОВЕРЯЕТ, что активный администратор с локальным паролем есть, и в
# production отказывается подниматься, если его нет: это ловит случай, когда
# встроенную учётную запись удалили или отключили.
#
# Переход на Keycloak позже НЕ сводится к смене AUTH_MODE: сначала обязательно
# связать учётные записи, иначе Keycloak заведёт людям вторые, беспра́вные строки.
#
#   pnpm link-sso --map ./sso-map.json --dry-run
#   pnpm link-sso --map ./sso-map.json --apply

# --- Наблюдаемость (§11) ---
# Версия развёрнутого кода: попадает в каждую запись журнала ошибок и в
# почасовой ряд, и по ней журнал отвечает на «сломалось после деплоя»
# (ADR-0010). Пусто — в ряде честно стоит `unknown`.
APP_RELEASE=


# =====================================================================
# Всё остальное: значения по умолчанию годятся, но переменные существуют
# =====================================================================
#
# Ниже — переменные, у которых есть рабочее значение по умолчанию. Задавать их
# руками не требуется, и потому их долго здесь не было. Это оказалось ошибкой:
# оператор не может настроить то, о существовании чего не знает, а сверка
# `env-examples.test.ts` требует, чтобы КАЖДАЯ переменная схемы была здесь
# названа. Значение после `=` — то, которое подставит `loadEnv()` само.

# --- Пул подключений ---
# Верхняя граница соединений процесса API. Считать вместе с воркером: у роли в
# кластере общий предел, и два процесса делят его между собой.
# PG_POOL_MAX=10

# --- Локальный вход: остальное ---
# Алгоритм хранения пароля. Значение одно, поле существует ради будущей смены:
# при ней старые хэши обязаны остаться проверяемыми.
# AUTH_LOCAL_HASH=scrypt
# Блокировка по ЛОГИНУ (в дополнение к лимиту по адресу): десять неудач за час.
# AUTH_LOCAL_LOGIN_MAX_PER_LOGIN_HOUR=10

# --- Файлы и предпросмотр ---
# Чем портал показывает PDF. `pdfjs` — рендер в браузере.
# PREVIEW_MODE=pdfjs
# Потолок одной загрузки, байты. 200 МБ.
# MAX_UPLOAD_BYTES=209715200
# Потолок страниц в одном файле: защита от «книги» вместо комплекта.
# MAX_PAGES_PER_FILE=500
# Путь к `pdftoppm`. Пусто — берётся из PATH. Без него не растеризуются страницы.
# PDFTOPPM_PATH=

# =====================================================================
# Интеграция с RD WEB
# =====================================================================
#
# Пусто — интеграция выключена. Пароль и токен ниже — секреты: в `app_settings`
# они не хранятся и через админку не правятся (§10).

# --- Распознавание (OCR) ---
# RDWEB_BASE_URL=
# RDWEB_USER=
# RDWEB_PASSWORD=
# Список проектов RD WEB, куда порталу разрешено обращаться. Пусто — не
# разрешено никуда: ограничение задаётся списком, а не отсутствием списка.
# RDWEB_PROJECT_ALLOWLIST=
# Модель OCR и её провайдер; профили промтов — по типам блоков
# (`text=<id>,image=<id>,stamp=<id>`).
# RDWEB_OCR_MODEL=
# RDWEB_OCR_PROVIDER=lmstudio
# RDWEB_OCR_PROMPT_PROFILES=

# --- Исполнительная документация (document-sync) ---
# Отдельный адрес, а не RDWEB_BASE_URL: это другой сервис.
# RDWEB_EXEC_BASE_URL=
# RDWEB_EXEC_TOKEN=
# RDWEB_EXEC_PROJECT_ID=
# RDWEB_EXEC_TIMEOUT_MS=120000

# =====================================================================
# LLM
# =====================================================================
#
# `none` — портал не обращается к модели вовсе, и это боевое значение по
# умолчанию: включение стоит денег и требует явного решения.
# LLM_PROVIDER=none
# PROXY_LLM_BASE_URL=
# PROXY_LLM_TOKEN=
# Разрешённые модели и модель по умолчанию. Пустой список разрешений означает,
# что не разрешена ни одна.
# LLM_MODEL_ALLOWLIST=
# LLM_MODEL=
# Месячный бюджет. 0 — без ограничения по деньгам; лимит частоты действует всегда.
# LLM_BUDGET_MONTHLY=0
# LLM_RATE_LIMIT_PER_MIN=60
# LLM_TIMEOUT_MS=240000
# Кэш ответов модели: сколько записей держать и как долго.
# LLM_CACHE_MAX_ENTRIES=500
# LLM_CACHE_TTL_MS=3600000

# =====================================================================
# Локальная детекция (ONNX)
# =====================================================================
#
# Потоки инференса. Больше — не быстрее: детекция идёт на CPU рядом с воркером,
# и лишние потоки отбирают их у остального конвейера.
# ORT_INTRA_OP_THREADS=2
# ORT_INTER_OP_THREADS=1

# =====================================================================
# Хранение и юридический запрет
# =====================================================================
#
# Срок хранения данных, дней. Десять лет — срок хранения ИД.
# RETENTION_DAYS=3650
# Юридический запрет: пока включён, удаление отвергается даже администратору.
# LEGAL_HOLD_ENABLED=true

# =====================================================================
# Наблюдаемость (§11)
# =====================================================================

# LOG_LEVEL=info

# Пороги «медленно». Превышение попадает в журнал медленных операций, а не в
# ошибки: медленный ответ — не отказ, но именно по этим рядам видно деградацию.
# SLOW_REQUEST_MS=1000
# SLOW_QUERY_MS=300
# SLOW_EXTERNAL_MS=5000

# Куда уходят ошибки: `db` — в таблицы портала (ADR-0010), `sentry` — наружу.
# При `sentry` адрес обязателен.
# ERROR_REPORTER=db
# SENTRY_DSN=

# Накопитель журнала ошибок: как часто сбрасывать, как часто брать образец,
# сколько новых сигнатур принимать за интервал и сколько образцов на сигнатуру.
# ERROR_JOURNAL_FLUSH_MS=2000
# ERROR_JOURNAL_SAMPLE_INTERVAL_MS=300000
# ERROR_JOURNAL_NEW_SIGNATURE_LIMIT=500
# ERROR_SAMPLES_PER_ISSUE=200

# Сроки хранения рядов наблюдаемости, дней. Образцы живут меньше счётчиков:
# в образце лежит контекст запроса, а в счётчике — только число.
# ERROR_SAMPLE_RETENTION_DAYS=90
# ERROR_STATS_RETENTION_DAYS=365
# SLOW_OPERATION_RETENTION_DAYS=90

# Приём ошибок браузера. Выключение делает невидимыми отказы, которые на сервере
# не оставляют следа вовсе, — а это ровно класс дефекта S44.
# CLIENT_ERROR_REPORTING=true
# CLIENT_ERROR_RATE_LIMIT_MAX=30
# CLIENT_ERROR_GLOBAL_LIMIT_PER_MIN=600

# `/metrics`. Наружу его закрывает nginx, а не эта переменная.
# METRICS_ENABLED=true

# =====================================================================
# Сеть и защита
# =====================================================================

# Лимит запросов на адрес. Работает вместе с TRUST_PROXY: без доверенного прокси
# адресом всех клиентов окажется адрес nginx, и лимит станет общим.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# Принимать `X-Request-Id` от клиента. Включать только за своим прокси: иначе
# корреляция журналов подделывается, а произвольная строка отражается в ответе.
# TRUST_REQUEST_ID=false

# =====================================================================
# Только для тестов: настоящая PostgreSQL
# =====================================================================
#
# Не переменная приложения — `loadEnv()` её не читает. Она нужна ГЕЙТУ.
#
# Тесты по умолчанию поднимают pglite (настоящий PostgreSQL 18 в WASM, без
# Docker — ADR-0002). У него одно соединение, поэтому истинная конкурентность —
# захват задачи двумя воркерами через `FOR UPDATE SKIP LOCKED`, гонка при
# двойном клике в `ensureDraftLayout` — на нём непроверяема. Такие тесты
# помечены `skipIf(!hasRealPostgres())` и МОЛЧА пропускаются.
#
# Закрыть этот долг должен был CI, где поднимался postgres:18. CI удалён
# (ADR-0026), поэтому база ставится локально — нативно, Docker не нужен:
#
#   1. Установить PostgreSQL 18 для Windows (штатный установщик EDB).
#   2. Завести базу и включить расширения — стандарт запрещает
#      `CREATE EXTENSION` внутри миграций приложения, они включаются заранее:
#
#        createdb id_portal_test
#        psql -d id_portal_test -c 'CREATE EXTENSION IF NOT EXISTS pgcrypto;' \
#                               -c 'CREATE EXTENSION IF NOT EXISTS citext;' \
#                               -c 'CREATE EXTENSION IF NOT EXISTS pg_trgm;'
#
#   3. Задать переменную в окружении оболочки (НЕ в этом файле — здесь она
#      только описана; тесты читают `process.env`).
#   4. Проверить:  pnpm db:probe
#
# Заданная переменная не заменяет pglite, а ДОБАВЛЯЕТ пропущенные тесты: в
# отчёте `pnpm -r test` число пропущенных обязано стать нулём.
#
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/id_portal_test
